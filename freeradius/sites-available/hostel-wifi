# =============================================================================
# FreeRADIUS Virtual Server: Hostel Wi-Fi Authentication & Accounting
# Location: /etc/freeradius/3.0/sites-available/hostel-wifi
# =============================================================================

server hostel-wifi {
    listen {
        type = auth
        ipaddr = *
        port = 1812
        limit {
            max_connections = 64
            lifetime = 0
            idle_timeout = 30
        }
    }

    listen {
        type = acct
        ipaddr = *
        port = 1813
        limit {
            max_pps = 0
        }
    }

    # Authorization Phase: Reads radcheck & radreply from Supabase PostgreSQL
    authorize {
        preprocess
        chap
        mschap
        
        # Pull check items & reply attributes from Supabase
        sql

        # If user found in radcheck with Auth-Type := Accept, grant instant access
        if (&control:Auth-Type == "Accept") {
            ok
        }
        elsif (&control:Auth-Type == "Reject") {
            reject
        }
        else {
            pap
        }
    }

    # Authentication Phase
    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
    }

    # Post-Auth Phase (Returns Mikrotik-Rate-Limit, Session-Timeout)
    post-auth {
        update reply {
            &Reply-Message := "Welcome to Hostel High-Speed Wi-Fi"
        }
        sql
    }

    # Accounting Phase: Log connection starts, stops, and bandwidth data
    accounting {
        detail
        sql
    }
}
