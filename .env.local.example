# =============================================================================
# Hostel Wi-Fi Billing System - Environment Configuration
# =============================================================================

# Application Base URL (Used for payment callback redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Project URL from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous API Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Secret Service Role Key (NEVER expose to client; used for admin & webhook actions)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Direct PostgreSQL connection string (Used by FreeRADIUS rlm_sql module)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# -----------------------------------------------------------------------------
# Payment Gateway Configuration (Mobile Money: MTN, Telecel, AirtelTigo)
# -----------------------------------------------------------------------------
# Active Payment Provider: 'paystack' or 'flutterwave'
PAYMENT_PROVIDER=paystack

# Paystack API Keys (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_hash

# Flutterwave API Keys (Alternative for Ghana MoMo)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_secret_hash

# -----------------------------------------------------------------------------
# FreeRADIUS / Network Controller Policy Defaults
# -----------------------------------------------------------------------------
DEFAULT_FALLBACK_DOWNLOAD_MBPS=50
DEFAULT_FALLBACK_UPLOAD_MBPS=20
ACCOUNTING_INTERIM_INTERVAL_SEC=300
